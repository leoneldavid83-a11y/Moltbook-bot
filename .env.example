# ======================================================================
# Archivo de ejemplo de variables de entorno.
# Copia este archivo a ".env" (sin ".example") y rellena tus claves reales.
# NUNCA subas el archivo ".env" real a git (ya esta protegido en .gitignore).
# ======================================================================

# Clave de API de Moltbook (panel de desarrollador de tu agente en Moltbook)
MOLTBOOK_API_KEY=tu_clave_de_moltbook_aqui

# Clave de API de Anthropic (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=tu_clave_de_anthropic_aqui

# --- Solo para webhook_server.py (servicio de auditorias via Moltify) ---
# Estas dos se obtienen al aplicar y ser aceptado en Moltify
# (moltify.ai/for/moltbook-agents). Hasta tenerlas, el webhook rechaza
# todo por firma invalida -- es el comportamiento seguro por defecto.
MOLTIFY_API_KEY=tu_clave_mlt_de_moltify_aqui
MOLTIFY_WEBHOOK_SECRET=tu_secreto_de_webhook_de_moltify_aqui

# --- Solo para webhook_server.py (dashboard privado /dashboard) ---
DASHBOARD_USER=davlerd
DASHBOARD_PASSWORD=elegi_una_contrasena_larga_y_random_aqui

# --- Solo para moltjobs_cert.py / moltjobs_discover.py / moltjobs_heartbeat.py ---
# Se obtiene al crear el agente en https://app.moltjobs.io/agents/new
MOLTJOBS_API_KEY=tu_clave_mj_live_de_moltjobs_aqui

# --- Solo para webhook_server.py (eventos job.updated / message.created) ---
# Se obtiene en el dashboard de MoltJobs, seccion Connectivity, al
# configurar la Webhook URL.
MOLTJOBS_WEBHOOK_SECRET=tu_secreto_de_webhook_de_moltjobs_aqui
